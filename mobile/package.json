{
  "name": "tazkirati-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrap of the Tazkirati web portal. webDir points at ../frontend so the native shell stays in sync with the web build.",
  "scripts": {
    "sync": "cap sync && npm run --silent point-native-at-v2",
    "sync:ios": "cap sync ios && npm run --silent point-native-at-v2:ios",
    "sync:android": "cap sync android && npm run --silent point-native-at-v2:android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:ios": "npm run --silent sync:ios",
    "build:android": "npm run --silent sync:android",
    "assets": "capacitor-assets generate",
    "point-native-at-v2": "npm run --silent point-native-at-v2:ios && npm run --silent point-native-at-v2:android",
    "point-native-at-v2:ios": "cp ../frontend/index-v2.html ios/App/App/public/index.html",
    "point-native-at-v2:android": "cp ../frontend/index-v2.html android/app/src/main/assets/public/index.html || true"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "capacitor-screenshot": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0",
    "typescript": "^5.4.0"
  }
}
